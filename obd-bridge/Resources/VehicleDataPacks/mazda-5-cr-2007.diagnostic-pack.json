          "maximumDurationSeconds": 180,
          "entryConditions": ["coolant-temperature>=80", "vehicle-speed=0", "fuel-mode-marked"],
          "exitConditions": ["phase-duration>=90"],
          "signals": [
            {"signal":{"namespace":"sae","service":"01","identifier":"05","ecuAddress":null},"required":true,"targetFrequencyHz":1,"rationale":"Verify full warm-up"},
